{
  "name": "dsh-hoi4-modding",
  "version": "1.4.1",
  "description": "Hearts of Iron IV 1.19.3 modding skill bundle for DeepSeek Harness: one hoi4-modding skill plus 14 Python tools to scaffold, statically verify, install and debug HOI4 mods — focus trees, events, decisions, ideas, characters, technologies, MIO, special projects, scripted GUI/topbar, localisation, DDS icons, 18-slot tank designer, 3D tank models, CJK font auditing — with a 23-workshop-mod technique survey and a multi-agent playbook. No game assets shipped.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "skills/hoi4-modding/SKILL.md",
    "skills/hoi4-modding/INSTALL.md",
    "skills/hoi4-modding/references/*.md",
    "skills/hoi4-modding/scripts/*.py",
    "README.md",
    "LICENSE",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
